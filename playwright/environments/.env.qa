# QA environment config — copy to .env.qa and fill in real values
ENV=qa

BASE_URL=https://www.saucedemo.com
API_BASE_URL=
API_TOKEN=

# Database (optional — only if DbHelpers are used)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Auth storage state path
AUTH_STATE_PATH=playwright/storage/auth/user.json

# Playwright settings
PW_RETRIES=0
PW_TRACE=on-first-retry
TEST_ID_ATTRIBUTE=data-testid

# Saucedemo credentials
USERNAME=standard_user
PASSWORD=secret_sauce